# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha2"
synopsis: "Unix transport for the CometBFT JSON-RPC client"
description: """
Cardano's and Tron's arrangement: this is Cosmos_rpc_flow.Make applied to a
Unix file descriptor and nothing else, so the Unix path and the unikernel
path are the same implementation with a different flow underneath.

The guarded live-network executable ships in this package: it is the only
thing here that signs with a real key and touches a network, and it needs a
Unix transport to do either."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cosmos"
bug-reports: "https://github.com/reuna-labs/ocaml-cosmos/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "cosmos-rpc" {= version}
  "cosmos-rpc-flow" {= version}
  "cosmos-tx" {= version}
  "cosmos-crypto" {= version}
  "cosmos-signer" {= version}
  "lwt" {>= "5.6.0"}
  "mirage-flow" {>= "4.0.0"}
  "mirage-flow-unix" {>= "4.0.0"}
  "tls" {>= "2.0.0"}
  "tls-lwt" {>= "2.0.0"}
  "x509"
  "ca-certs"
  "uri"
  "cstruct"
  "fmt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-cosmos.git"
