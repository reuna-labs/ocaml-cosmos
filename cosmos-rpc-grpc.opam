# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Cosmos gRPC query and tx services over any Mirage_flow.S"
description: """
cosmos.tx.v1beta1.Service, cosmos.auth.v1beta1.Query and
cosmos.bank.v1beta1.Query over gRPC, decoding into the same typed values the
JSON-RPC client produces, so that the two wire paths can be compared rather
than merely coexisting.

Functorised over the same flow signature as cosmos-rpc-flow. Not h2-mirage:
that package would do the functorising, but its closure assumes a full
network stack -- conduit-mirage, tcpip, tls, x509, dns-client -- and the
confidential Solo5 targets have a vsock instead. What h2 needs from a
transport is Gluten_lwt.IO, which is four functions, so this implements those
over a flow directly, following ocaml-tron."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cosmos"
bug-reports: "https://github.com/reuna-labs/ocaml-cosmos/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "cosmos-types" {= version}
  "cosmos-tx" {= version}
  "cosmos-proto" {= version}
  "cosmos-rpc" {= version}
  "web3-codec-protobuf" {>= "0.1.0~alpha1"}
  "grpc"
  "grpc-lwt"
  "h2" {>= "0.13.0"}
  "h2-lwt" {>= "0.13.0"}
  "gluten-lwt"
  "faraday"
  "bigstringaf"
  "lwt" {>= "5.6.0"}
  "cstruct" {>= "6.0.0"}
  "mirage-flow" {>= "4.0.0"}
  "fmt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-cosmos.git"
