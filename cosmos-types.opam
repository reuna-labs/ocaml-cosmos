# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha3"
synopsis: "Validated primitive types for Cosmos SDK chains"
description: """
Bech32 account, validator and consensus addresses; coins and denominations;
chain identifiers; transaction and block hashes; and the per-chain profile
that carries the bech32 prefix, fee denomination, minimum gas price and SDK
version.

The address is 20 or 32 raw bytes plus a prefix; its bech32 spelling is a
rendering. cosmos1... and cosmosvaloper1... are the same bytes under
different prefixes, which is why the prefix is part of the type rather than
part of the formatting."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cosmos"
bug-reports: "https://github.com/reuna-labs/ocaml-cosmos/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "web3-codec-bech32" {>= "0.1.0~alpha1"}
  "digestif" {>= "1.2.0"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-cosmos.git"
