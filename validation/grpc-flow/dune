; gRPC, built over a flow that is not a socket.
;
; The claim cosmos-rpc-grpc makes is that HTTP/2 reaches a Solo5 vsock without
; a network stack. This is where that stops being a claim: the flow here is two
; in-memory buffers, and if the transport had reached for h2-mirage -- or for
; anything else assuming conduit, tcpip or DNS -- it would not link.
;
; test/no_io_guard.sh builds it.

(executable
 (name grpc_flow_link)
 (libraries
  cosmos-rpc
  cosmos-rpc-grpc
  cosmos-types
  lwt
  lwt.unix
  cstruct
  mirage-flow
  fmt))
