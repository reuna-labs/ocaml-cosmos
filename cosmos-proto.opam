# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha3"
synopsis: "Generated protobuf bindings for the Cosmos SDK wire types"
description: """
Bindings generated with ocaml-protoc-plugin from the .proto tree vendored at
proto/, pinned to cosmos-sdk v0.55.0, ibc-go v11.2.0 and wasmd v0.70.3. The
generated sources are committed, so building this package requires neither
protoc nor the plugin.

Depends only on web3-codec-protobuf, whose closure is base64 + ptime, and in
particular not on unix, so it links into a MirageOS/Solo5 unikernel.

These are wire types, not a validated model. Every message in a TxBody is a
google.protobuf.Any that the generated code cannot narrow; narrowing it is
cosmos-tx's job."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cosmos"
bug-reports: "https://github.com/reuna-labs/ocaml-cosmos/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "web3-codec-protobuf" {>= "0.1.0~alpha1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-cosmos.git"
