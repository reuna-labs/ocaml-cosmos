# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha3"
synopsis: "Typed transport-independent CometBFT and Cosmos gRPC client"
description: """
The CometBFT JSON-RPC method catalogue, the SDK query and tx services, gas
and fee estimation, a tagged confirmation state and the submission state
machine -- all pure. The transport is a module type.

Confirmation is tagged, not boolean. A code-0 broadcast_tx_sync means the
transaction entered a mempool; delivery is a tx query returning code 0 at a
height, and finality is depth beyond that. Conflating the three is the
commonest way to report a failed transfer as a successful one."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cosmos"
bug-reports: "https://github.com/reuna-labs/ocaml-cosmos/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "cosmos-types" {= version}
  "cosmos-tx" {= version}
  "cosmos-proto" {= version}
  "web3-codec-protobuf" {>= "0.1.0~alpha1"}
  "yojson" {>= "2.0.0"}
  "base64" {>= "3.1.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-cosmos.git"
