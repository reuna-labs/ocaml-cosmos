; test_tx reads the protoc fixtures, so dune has to copy them into the build
; tree. conformance/ is data_only_dirs at the root, which is what stops dune
; looking for dune files inside it.

(tests
 (modules
  (:standard \ test_crypto test_tx test_amino test_transcript))
 (names
  test_cosmos
  test_address
  test_amount
  test_amount_props
  test_coin
  test_profile
  test_policy
  test_rpc
  test_submission
  test_http
  test_resilience
  test_endpoint)
 (deps
  (glob_files ../conformance/fixtures/protoc/*.hex)
  (glob_files ../conformance/fixtures/amino/*.json)
  (glob_files ../conformance/fixtures/rpc/*.json))
 (libraries
  mirage-crypto-rng
  cosmos
  cosmos-types
  cosmos-crypto
  cosmos-tx
  cosmos-signer
