  cosmos-rpc-flow
  cosmos-rpc-grpc
  cosmos-rpc-unix
  web3-codec-bech32
  digestif
  yojson
  mirage-crypto-ec
  fmt
  alcotest
  qcheck-core
  qcheck-alcotest))

